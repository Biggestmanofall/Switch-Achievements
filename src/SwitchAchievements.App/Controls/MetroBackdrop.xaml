<!--
    MetroBackdrop (M5.7 Task 3.1): the main window's layered geometric background —
    a cropped red sphere with concentric rings, halftone patches, sweeping ribbons,
    glossy stars and spheres. Purely decorative: no data, never hit-testable.

    Performance: everything static lives in one layer cached as a bitmap (rendered once
    per size change). Only three small bubbles drift, slowly, at a low frame rate.
-->
<UserControl x:Class="SwitchAchievements.App.Controls.MetroBackdrop"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" Focusable="False" ClipToBounds="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SwitchAchievements.App;component/Styles/MetroDecor.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <RadialGradientBrush x:Key="GlowRed">
                <GradientStop Color="#B3FF001E" Offset="0"/>
                <GradientStop Color="#33B80012" Offset="0.55"/>
                <GradientStop Color="#00B80012" Offset="1"/>
            </RadialGradientBrush>
            <Storyboard x:Key="Drift" RepeatBehavior="Forever" AutoReverse="True" Timeline.DesiredFrameRate="20">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-14" Duration="0:0:7">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- ================= Static layer (bitmap-cached) ================= -->
        <Grid>
            <Grid.CacheMode>
                <BitmapCache EnableClearType="False" RenderAtScale="1"/>
            </Grid.CacheMode>

            <!-- Saturated red light regions over the near-black base. -->
            <Ellipse Width="980" Height="760" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-330,-300,0,0" Fill="{StaticResource GlowRed}"/>
            <Ellipse Width="900" Height="700" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-260,-300" Fill="{StaticResource GlowRed}" Opacity="0.85"/>

            <!-- Big cropped red sphere (top right) with concentric rings and a black halftone. -->
            <Ellipse Width="1240" Height="1240" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-680,-470,0"
                     Stroke="White" StrokeThickness="2" Opacity="0.22"/>
            <Ellipse Width="1120" Height="1120" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-620,-410,0"
                     Stroke="{StaticResource DecorRedBrush}" StrokeThickness="4" Opacity="0.8"/>
            <Ellipse Width="1000" Height="1000" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-560,-350,0"
                     Stroke="{StaticResource DecorOutline}" StrokeThickness="16"/>
            <Ellipse Width="820" Height="820" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-470,-260,0"
                     Fill="{StaticResource DecorSphereRed}" Stroke="{StaticResource DecorOutline}" StrokeThickness="20"/>
            <Ellipse Width="560" Height="560" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-160,-60,0"
                     Fill="{StaticResource HalftoneBlack}" OpacityMask="{StaticResource HalftoneFade}" Opacity="0.55"/>
            <Ellipse Width="440" Height="200" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-70,160,0"
                     Fill="{StaticResource DecorSphereGloss}" Opacity="0.35"/>

            <!-- Halftone patches. -->
            <Rectangle Width="560" Height="460" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-140,0,0,40"
                       Fill="{StaticResource HalftoneRedLarge}" OpacityMask="{StaticResource HalftoneFade}" Opacity="0.6"/>
            <Rectangle Width="460" Height="420" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-120,-120,0,0"
                       Fill="{StaticResource HalftoneRedSmall}" OpacityMask="{StaticResource HalftoneFade}" Opacity="0.7"/>
            <Rectangle Width="420" Height="420" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,120,-150,0"
                       Fill="{StaticResource HalftoneRedSmall}" OpacityMask="{StaticResource HalftoneFade}" Opacity="0.55"/>

            <!-- Hollow outlined circles. -->
            <Ellipse Width="170" Height="170" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-70,150,0,0"
                     Stroke="{StaticResource DecorRedBrush}" StrokeThickness="12"/>
            <Ellipse Width="110" Height="110" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-40,180,0,0"
                     Stroke="{StaticResource DecorOutline}" StrokeThickness="8"/>

            <!-- Sweeping ribbons across the bottom (scaled together so they stay aligned). -->
            <Viewbox Stretch="Fill" VerticalAlignment="Bottom" Height="300">
                <Canvas Width="1000" Height="300">
                    <Path Fill="{StaticResource DecorRibbonFill}" Data="M0,150 C260,30 560,280 1000,70 L1000,140 C560,340 260,100 0,225 Z"/>
                    <Path Stroke="White" StrokeThickness="2.5" Opacity="0.55" Data="M0,156 C260,36 560,286 1000,76"/>
                    <Path Fill="{StaticResource DecorOutline}" Opacity="0.92" Data="M0,245 C300,140 620,330 1000,190 L1000,226 C620,365 300,180 0,282 Z"/>
                    <Path Stroke="{StaticResource DecorRedBrush}" StrokeThickness="3" Opacity="0.85" Data="M0,300 C320,205 640,360 1000,262"/>
                </Canvas>
            </Viewbox>

            <!-- Thick-outlined hollow circle and a dark sphere riding the ribbons. -->
            <Ellipse Width="210" Height="210" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,150,-90"
                     Stroke="{StaticResource DecorOutline}" StrokeThickness="18"/>
            <Ellipse Width="210" Height="210" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,150,-90"
                     Stroke="{StaticResource DecorRedBrush}" StrokeThickness="3" Opacity="0.9" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform ScaleX="1.22" ScaleY="1.22"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <ContentControl Style="{StaticResource DarkSphere}" Width="120" Height="120" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="300,0,0,-34"/>

            <!-- Stars. -->
            <ContentControl Style="{StaticResource GlossyStar}" Width="270" Height="270" Tag="7"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-92,0,0,-58">
                <ContentControl.RenderTransform>
                    <RotateTransform Angle="-14"/>
                </ContentControl.RenderTransform>
            </ContentControl>
            <ContentControl Style="{StaticResource GlossyStar}" Width="120" Height="120" Tag="5"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-24,46">
                <ContentControl.RenderTransform>
                    <RotateTransform Angle="18"/>
                </ContentControl.RenderTransform>
            </ContentControl>
            <ContentControl Style="{StaticResource GlossyStar}" Width="82" Height="82" Tag="4"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,230,0">
                <ContentControl.RenderTransform>
                    <RotateTransform Angle="-10"/>
                </ContentControl.RenderTransform>
            </ContentControl>
            <ContentControl Style="{StaticResource OutlineStar}" Width="58" Height="58" Tag="3" BorderBrush="{StaticResource DecorRedBrush}"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="470,14,0,0">
                <ContentControl.RenderTransform>
                    <RotateTransform Angle="12"/>
                </ContentControl.RenderTransform>
            </ContentControl>
            <ContentControl Style="{StaticResource OutlineStar}" Width="40" Height="40" Tag="2.5" Opacity="0.7"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="520,0,0,128"/>
            <ContentControl Style="{StaticResource OutlineStar}" Width="70" Height="70" Tag="3" Opacity="0.55"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,40,-18,0">
                <ContentControl.RenderTransform>
                    <RotateTransform Angle="-20"/>
                </ContentControl.RenderTransform>
            </ContentControl>

            <!-- Small dots. -->
            <Ellipse Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="560,40,0,0" Fill="White" Opacity="0.8"/>
            <Ellipse Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="590,66,0,0" Fill="{StaticResource DecorRedBrush}"/>
            <Ellipse Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="460,0,0,96" Fill="{StaticResource DecorRedBrush}"/>
            <Ellipse Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,330,70" Fill="White" Opacity="0.75"/>
            <Ellipse Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0"
                     Stroke="White" StrokeThickness="2" Opacity="0.6"/>
        </Grid>

        <!-- ================= Drifting bubbles (the only animated decoration) ================= -->
        <ContentControl Style="{StaticResource GlossySphere}" Width="64" Height="64" Tag="3"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,-150">
            <ContentControl.RenderTransform>
                <TranslateTransform/>
            </ContentControl.RenderTransform>
            <ContentControl.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard Storyboard="{StaticResource Drift}"/>
                </EventTrigger>
            </ContentControl.Triggers>
        </ContentControl>
        <ContentControl Style="{StaticResource GlossySphere}" Width="34" Height="34" Tag="2"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="640,26,0,0">
            <ContentControl.RenderTransform>
                <TranslateTransform/>
            </ContentControl.RenderTransform>
            <ContentControl.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True" Timeline.DesiredFrameRate="20" BeginTime="0:0:2">
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="10" Duration="0:0:5.5">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </ContentControl.Triggers>
        </ContentControl>
        <ContentControl Style="{StaticResource GlossySphere}" Width="26" Height="26" Tag="2"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="210,0,0,150">
            <ContentControl.RenderTransform>
                <TranslateTransform/>
            </ContentControl.RenderTransform>
            <ContentControl.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True" Timeline.DesiredFrameRate="20" BeginTime="0:0:1">
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-12" Duration="0:0:6.5">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </ContentControl.Triggers>
        </ContentControl>
    </Grid>
</UserControl>
