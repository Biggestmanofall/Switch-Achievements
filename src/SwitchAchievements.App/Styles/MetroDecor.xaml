<!--
    Red Frutiger Metro decoration library (M5.7 Task 3.1): reusable vector stars, glossy
    spheres, rings, ribbons, and halftone patterns. Purely decorative — no data, no input.
    Every piece is native WPF geometry, so it scales with the window.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Palette ============ -->
    <Color x:Key="DecorRed">#FF001E</Color>
    <Color x:Key="DecorRedBright">#F00016</Color>
    <Color x:Key="DecorCrimson">#B80012</Color>
    <Color x:Key="DecorDarkRed">#65000B</Color>
    <Color x:Key="DecorNearBlack">#100508</Color>
    <Color x:Key="DecorPink">#FF5A6B</Color>

    <SolidColorBrush x:Key="DecorOutline" Color="{StaticResource DecorNearBlack}"/>
    <SolidColorBrush x:Key="DecorRedBrush" Color="{StaticResource DecorRed}"/>

    <!-- ============ Geometry ============ -->
    <!-- Five-pointed star in a 100x100 box (outer radius 50, inner radius 21). -->
    <Geometry x:Key="StarGeometry">M 50,0 L 62.3,33 L 97.6,34.5 L 70,56.5 L 79.4,90.5 L 50,71 L 20.6,90.5 L 30,56.5 L 2.4,34.5 L 37.7,33 Z</Geometry>

    <!-- ============ Fills ============ -->
    <LinearGradientBrush x:Key="DecorStarFill" StartPoint="0.3,0" EndPoint="0.7,1">
        <GradientStop Color="{StaticResource DecorPink}" Offset="0"/>
        <GradientStop Color="{StaticResource DecorRed}" Offset="0.42"/>
        <GradientStop Color="{StaticResource DecorCrimson}" Offset="0.8"/>
        <GradientStop Color="{StaticResource DecorDarkRed}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DecorStarGloss" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D9FFFFFF" Offset="0"/>
        <GradientStop Color="#40FFFFFF" Offset="0.4"/>
        <GradientStop Color="#00FFFFFF" Offset="0.55"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="DecorSphereRed" GradientOrigin="0.35,0.28" Center="0.45,0.4" RadiusX="0.65" RadiusY="0.65">
        <GradientStop Color="{StaticResource DecorPink}" Offset="0"/>
        <GradientStop Color="{StaticResource DecorRed}" Offset="0.38"/>
        <GradientStop Color="{StaticResource DecorCrimson}" Offset="0.75"/>
        <GradientStop Color="{StaticResource DecorDarkRed}" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="DecorSphereDark" GradientOrigin="0.3,0.25" Center="0.45,0.4" RadiusX="0.65" RadiusY="0.65">
        <GradientStop Color="#5E0A16" Offset="0"/>
        <GradientStop Color="#2A060C" Offset="0.45"/>
        <GradientStop Color="{StaticResource DecorNearBlack}" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="DecorSphereGloss" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E6FFFFFF" Offset="0"/>
        <GradientStop Color="#1AFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DecorRibbonFill" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource DecorDarkRed}" Offset="0"/>
        <GradientStop Color="{StaticResource DecorRed}" Offset="0.35"/>
        <GradientStop Color="{StaticResource DecorRedBright}" Offset="0.6"/>
        <GradientStop Color="{StaticResource DecorCrimson}" Offset="1"/>
    </LinearGradientBrush>

    <!-- ============ Halftone dot patterns (tiled vector drawings) ============
         Two dots per tile on a diagonal give the offset rows of a print halftone.
         Pair with a radial OpacityMask so the pattern fades out at its edges. -->
    <DrawingBrush x:Key="HalftoneRedLarge" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z"/>
                <GeometryDrawing Brush="{StaticResource DecorRedBrush}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="4,4" RadiusX="3.4" RadiusY="3.4"/>
                            <EllipseGeometry Center="12,12" RadiusX="3.4" RadiusY="3.4"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="HalftoneRedSmall" TileMode="Tile" Viewport="0,0,12,12" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H12 V12 H0 Z"/>
                <GeometryDrawing Brush="{StaticResource DecorRedBrush}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="3,3" RadiusX="1.5" RadiusY="1.5"/>
                            <EllipseGeometry Center="9,9" RadiusX="1.5" RadiusY="1.5"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="HalftoneBlack" TileMode="Tile" Viewport="0,0,14,14" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H14 V14 H0 Z"/>
                <GeometryDrawing Brush="{StaticResource DecorOutline}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="3.5,3.5" RadiusX="2.6" RadiusY="2.6"/>
                            <EllipseGeometry Center="10.5,10.5" RadiusX="2.6" RadiusY="2.6"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- Fades a halftone patch from solid at its centre to nothing at its edge. -->
    <RadialGradientBrush x:Key="HalftoneFade">
        <GradientStop Color="#FF000000" Offset="0"/>
        <GradientStop Color="#99000000" Offset="0.45"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </RadialGradientBrush>

    <!-- ============ Glossy star ============
         Size with Width/Height; outline colour = BorderBrush; outline thickness = Tag. -->
    <Style x:Key="GlossyStar" TargetType="ContentControl">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="BorderBrush" Value="{StaticResource DecorOutline}"/>
        <Setter Property="Tag" Value="4"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Path Data="{StaticResource StarGeometry}" Stretch="Uniform" Fill="{StaticResource DecorStarFill}"
                              Stroke="{TemplateBinding BorderBrush}" StrokeLineJoin="Round"
                              StrokeThickness="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Path Data="{StaticResource StarGeometry}" Stretch="Uniform" Fill="{StaticResource DecorStarGloss}"
                              RenderTransformOrigin="0.5,0.42">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="0.72" ScaleY="0.72"/>
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hollow star: outline only. Stroke colour = BorderBrush; thickness = Tag. -->
    <Style x:Key="OutlineStar" TargetType="ContentControl">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="BorderBrush" Value="White"/>
        <Setter Property="Tag" Value="3"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Path Data="{StaticResource StarGeometry}" Stretch="Uniform" Stroke="{TemplateBinding BorderBrush}" StrokeLineJoin="Round"
                          StrokeThickness="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Glossy spheres ============
         Background = sphere fill; outline = BorderBrush; thickness = Tag. -->
    <Style x:Key="GlossySphere" TargetType="ContentControl">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="{StaticResource DecorSphereRed}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DecorOutline}"/>
        <Setter Property="Tag" Value="3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}"
                                 StrokeThickness="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="7*"/>
                                <RowDefinition Height="34*"/>
                                <RowDefinition Height="59*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20*"/>
                                <ColumnDefinition Width="60*"/>
                                <ColumnDefinition Width="20*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Row="1" Grid.Column="1" Fill="{StaticResource DecorSphereGloss}"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DarkSphere" TargetType="ContentControl" BasedOn="{StaticResource GlossySphere}">
        <Setter Property="Background" Value="{StaticResource DecorSphereDark}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DecorRedBrush}"/>
        <Setter Property="Tag" Value="2"/>
    </Style>
</ResourceDictionary>
