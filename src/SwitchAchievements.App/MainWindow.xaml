<Window x:Class="SwitchAchievements.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SwitchAchievements.App.Converters"
        xmlns:controls="clr-namespace:SwitchAchievements.App.Controls"
        Title="Switch Achievements"
        Height="800" Width="1080"
        MinHeight="600" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource MetroWindowBackground}"
        FontFamily="{DynamicResource MetroFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <!--
        M5.7 Task 3: Red Frutiger Metro dashboard (Hero + tiles). Bound to MainViewModel
        (DataContext) and its Dashboard (DashboardViewModel) — the Task 2 contract, unchanged.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/FrutigerMetro.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:UtcToLocalTimeConverter x:Key="UtcToLocal"/>

            <!-- Hero tint layers: each fades itself in only for its own state, so state
                 changes cross-fade smoothly over the constant red base. -->
            <Storyboard x:Key="TintIn">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.5"/>
            </Storyboard>
            <Storyboard x:Key="TintOut">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.5"/>
            </Storyboard>
            <Style x:Key="HeroTint" TargetType="Border">
                <Setter Property="CornerRadius" Value="26"/>
                <Setter Property="Opacity" Value="0"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
            </Style>
            <Style x:Key="TintSearching" TargetType="Border" BasedOn="{StaticResource HeroTint}">
                <Setter Property="Background" Value="#4D2A1820"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Dashboard.MonitoringState}" Value="Searching">
                        <DataTrigger.EnterActions><BeginStoryboard Storyboard="{StaticResource TintIn}"/></DataTrigger.EnterActions>
                        <DataTrigger.ExitActions><BeginStoryboard Storyboard="{StaticResource TintOut}"/></DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="TintStopped" TargetType="Border" BasedOn="{StaticResource HeroTint}">
                <Setter Property="Background" Value="#B3302A30"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Dashboard.MonitoringState}" Value="Stopped">
                        <DataTrigger.EnterActions><BeginStoryboard Storyboard="{StaticResource TintIn}"/></DataTrigger.EnterActions>
                        <DataTrigger.ExitActions><BeginStoryboard Storyboard="{StaticResource TintOut}"/></DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="TintAmbiguous" TargetType="Border" BasedOn="{StaticResource HeroTint}">
                <Setter Property="Background" Value="#8CC7700F"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Dashboard.MonitoringState}" Value="Ambiguous">
                        <DataTrigger.EnterActions><BeginStoryboard Storyboard="{StaticResource TintIn}"/></DataTrigger.EnterActions>
                        <DataTrigger.ExitActions><BeginStoryboard Storyboard="{StaticResource TintOut}"/></DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="TintError" TargetType="Border" BasedOn="{StaticResource HeroTint}">
                <Setter Property="Background" Value="#A6420712"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Dashboard.MonitoringState}" Value="Error">
                        <DataTrigger.EnterActions><BeginStoryboard Storyboard="{StaticResource TintIn}"/></DataTrigger.EnterActions>
                        <DataTrigger.ExitActions><BeginStoryboard Storyboard="{StaticResource TintOut}"/></DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Orb pulse ring: runs only while searching or (re)connecting, at a reduced frame rate. -->
            <Storyboard x:Key="PulseRing" RepeatBehavior="Forever" Timeline.DesiredFrameRate="30">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.45" Duration="0:0:1.8"/>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.45" Duration="0:0:1.8"/>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.75" To="0" Duration="0:0:1.8"/>
            </Storyboard>
            <Style x:Key="PulseRingStyle" TargetType="Ellipse">
                <Setter Property="Stroke" Value="White"/>
                <Setter Property="StrokeThickness" Value="2"/>
                <Setter Property="Opacity" Value="0"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Dashboard.MonitoringState}" Value="Searching">
                        <DataTrigger.EnterActions><BeginStoryboard Name="PulseSearching" Storyboard="{StaticResource PulseRing}"/></DataTrigger.EnterActions>
                        <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="PulseSearching"/></DataTrigger.ExitActions>
                    </DataTrigger>
                    <!-- M5.8.1: no pulse while live tracking is disabled (nothing is being connected to). -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Dashboard.MonitoringState}" Value="Connecting"/>
                            <Condition Binding="{Binding Dashboard.HasDiagnostic}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.EnterActions><BeginStoryboard Name="PulseConnecting" Storyboard="{StaticResource PulseRing}"/></MultiDataTrigger.EnterActions>
                        <MultiDataTrigger.ExitActions><StopStoryboard BeginStoryboardName="PulseConnecting"/></MultiDataTrigger.ExitActions>
                    </MultiDataTrigger>
                    <DataTrigger Binding="{Binding Dashboard.MonitoringState}" Value="Reconnecting">
                        <DataTrigger.EnterActions><BeginStoryboard Name="PulseReconnecting" Storyboard="{StaticResource PulseRing}"/></DataTrigger.EnterActions>
                        <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="PulseReconnecting"/></DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- Layered geometric background (decorative, non-interactive). -->
        <controls:MetroBackdrop/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <Grid x:Name="DashboardContent" Margin="28,24,28,8" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <Grid.Triggers>
                        <!-- Gentle entrance on first show. -->
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="14" To="0" Duration="0:0:0.5">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ================= Header ================= -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Logo: a glossy red star on a dark sphere, ringed in white. -->
                        <Grid Width="58" Height="58" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Ellipse Stroke="White" StrokeThickness="2" Opacity="0.85"/>
                            <ContentControl Style="{StaticResource DarkSphere}" Margin="4" Tag="2.5"/>
                            <ContentControl Style="{StaticResource GlossyStar}" Width="36" Height="36" Tag="2.5" Margin="0,0,0,2">
                                <ContentControl.RenderTransform>
                                    <RotateTransform Angle="-8"/>
                                </ContentControl.RenderTransform>
                            </ContentControl>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ApplicationName}" FontFamily="{StaticResource MetroDisplayFont}" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{StaticResource MetroTextPrimary}"/>
                            <TextBlock Text="Achievement tracking for Switch 2 recompilations" FontSize="13" Margin="0,2,0,0"
                                       Foreground="{StaticResource MetroTextMuted}"/>
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource MetroGlossButton}" VerticalAlignment="Center"
                                Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="Settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontSize="14" Style="{StaticResource MetroIcon}" Margin="0,0,8,0"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- ================= Hero ================= -->
                    <Grid Grid.Row="1" Margin="8,0,8,12" MinHeight="210">
                        <Border CornerRadius="26" Background="{StaticResource MetroHeroBackground}" Effect="{StaticResource MetroHeroShadow}"/>
                        <!-- The body has no children or effect, so it doubles as the decoration's rounded clip mask. -->
                        <Border x:Name="HeroBody" CornerRadius="26" Background="{StaticResource MetroHeroBackground}"
                                BorderBrush="#100508" BorderThickness="3"/>

                        <!-- Hero geometry: rings around the orb, black halftone, a thick hollow
                             circle, a glossy star, and a white swoosh — clipped to the hero. -->
                        <Grid IsHitTestVisible="False" ClipToBounds="True">
                            <Grid.OpacityMask>
                                <VisualBrush Visual="{Binding ElementName=HeroBody}"/>
                            </Grid.OpacityMask>
                            <Ellipse Width="300" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-72,-76,0,0"
                                     Stroke="#100508" StrokeThickness="4" Opacity="0.4"/>
                            <Ellipse Width="220" Height="220" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-32,-36,0,0"
                                     Stroke="White" StrokeThickness="2" Opacity="0.4"/>
                            <Ellipse Width="160" Height="160" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-2,-6,0,0"
                                     Stroke="#100508" StrokeThickness="12" Opacity="0.35"/>
                            <Rectangle Width="460" Height="300" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-60,-80,0"
                                       Fill="{StaticResource HalftoneBlack}" OpacityMask="{StaticResource HalftoneFade}" Opacity="0.4"/>
                            <Ellipse Width="250" Height="250" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-120"
                                     Stroke="#100508" StrokeThickness="18" Opacity="0.5"/>
                            <Ellipse Width="250" Height="250" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-120"
                                     Stroke="White" StrokeThickness="2" Opacity="0.45" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Path Stretch="Fill" Height="130" VerticalAlignment="Top" Margin="260,-8,-30,0"
                                  Stroke="White" StrokeThickness="3" Opacity="0.3" Data="M0,120 C220,10 430,0 640,70"/>
                            <ContentControl Style="{StaticResource GlossyStar}" Width="96" Height="96" Tag="4"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-14,-22">
                                <ContentControl.RenderTransform>
                                    <RotateTransform Angle="16"/>
                                </ContentControl.RenderTransform>
                            </ContentControl>
                            <ContentControl Style="{StaticResource OutlineStar}" Width="26" Height="26" Tag="2" Opacity="0.7"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,300,0">
                                <ContentControl.RenderTransform>
                                    <RotateTransform Angle="-12"/>
                                </ContentControl.RenderTransform>
                            </ContentControl>
                            <ContentControl Style="{StaticResource OutlineStar}" Width="15" Height="15" Tag="1.5" Opacity="0.6"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,58,336,0"/>
                        </Grid>

                        <!-- State tints over the red base. -->
                        <Border Style="{StaticResource TintSearching}"/>
                        <Border Style="{StaticResource TintStopped}"/>
                        <Border Style="{StaticResource TintAmbiguous}"/>
                        <Border Style="{StaticResource TintError}"/>

                        <!-- Gloss and bubbles. -->
                        <Border CornerRadius="26,26,120,120" Height="96" VerticalAlignment="Top" Margin="1,1,1,0"
                                Background="{StaticResource MetroGloss}" IsHitTestVisible="False"/>
                        <Ellipse Width="190" Height="190" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,14"
                                 Fill="{StaticResource MetroBubble}" Opacity="0.55" IsHitTestVisible="False"/>
                        <Ellipse Width="90" Height="90" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,250,0"
                                 Fill="{StaticResource MetroBubble}" Opacity="0.4" IsHitTestVisible="False"/>
                        <Ellipse Width="46" Height="46" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,250,30"
                                 Fill="{StaticResource MetroBubble}" Opacity="0.45" IsHitTestVisible="False"/>

                        <Grid Margin="28,26,28,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Status orb: icon and colour per state (never colour alone: the text says it too). -->
                            <Grid Width="100" Height="100" VerticalAlignment="Top">
                                <Ellipse Style="{StaticResource PulseRingStyle}" IsHitTestVisible="False"/>
                                <!-- Dimensional rings: a thick black outline around a glossy red band. -->
                                <ContentControl Style="{StaticResource GlossySphere}" Tag="5" Effect="{StaticResource MetroSoftShadow}"/>
                                <Ellipse Margin="11" Stroke="#100508" StrokeThickness="3">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush GradientOrigin="0.4,0.3">
                                            <GradientStop Color="#FFFFFF" Offset="0"/>
                                            <GradientStop Color="#FBEFF0" Offset="0.6"/>
                                            <GradientStop Color="#E9C9CD" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Width="54" Height="26" VerticalAlignment="Top" Margin="0,16,0,0" Fill="#B3FFFFFF" IsHitTestVisible="False"/>
                                <TextBlock FontSize="34" AutomationProperties.Name="{Binding Dashboard.MonitoringStatusText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MetroIcon}">
                                            <Setter Property="Text" Value="&#xE71A;"/>
                                            <Setter Property="Foreground" Value="#9C4A54"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Dashboard.MonitoringState}" Value="Searching">
                                                    <Setter Property="Text" Value="&#xE721;"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Dashboard.MonitoringState}" Value="Connecting">
                                                    <Setter Property="Text" Value="&#xE895;"/>
                                                    <Setter Property="Foreground" Value="#C9283A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Dashboard.MonitoringState}" Value="Reconnecting">
                                                    <Setter Property="Text" Value="&#xE895;"/>
                                                    <Setter Property="Foreground" Value="#C9283A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Dashboard.MonitoringState}" Value="Monitoring">
                                                    <Setter Property="Text" Value="&#xE7FC;"/>
                                                    <Setter Property="Foreground" Value="#D81F30"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Dashboard.MonitoringState}" Value="Ambiguous">
                                                    <Setter Property="Text" Value="&#xE7C4;"/>
                                                    <Setter Property="Foreground" Value="#B4600A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Dashboard.MonitoringState}" Value="Error">
                                                    <Setter Property="Text" Value="&#xE7BA;"/>
                                                    <Setter Property="Foreground" Value="#9B0F1C"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Headline -->
                            <StackPanel Grid.Column="1" Margin="22,2,16,0" VerticalAlignment="Top">
                                <Border Background="#33FFFFFF" CornerRadius="11" Padding="10,3" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Dashboard.MonitoringStatusText, NotifyOnTargetUpdated=True}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="White"/>
                                </Border>
                                <TextBlock FontFamily="{StaticResource MetroDisplayFont}" FontSize="30" FontWeight="SemiBold" Foreground="White"
                                           TextWrapping="Wrap" Margin="0,10,0,0" RenderTransformOrigin="0,0.5">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform/>
                                    </TextBlock.RenderTransform>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <!-- The identified game's catalog name, otherwise the plain status summary. -->
                                            <Setter Property="Text" Value="{Binding Dashboard.GameDisplayName, NotifyOnTargetUpdated=True}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Dashboard.GameDisplayName}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="{Binding Dashboard.StatusSummary, NotifyOnTargetUpdated=True}"/>
                                                </DataTrigger>
                                                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-10" To="0" Duration="0:0:0.45">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding IntegrationName}" FontSize="14" Foreground="#F5D5D9" Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- Status chips -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Top" MinWidth="170">
                                <Border Style="{StaticResource MetroChip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0" StrokeThickness="2" Stroke="White">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Dashboard.Connection}" Value="Connected">
                                                            <Setter Property="Fill" Value="White"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Dashboard.Connection}" Value="Connecting">
                                                            <Setter Property="Fill" Value="#80FFFFFF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Dashboard.ConnectionText}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetroChip}" ToolTip="{Binding Dashboard.IdentificationDetail}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="12" Margin="0,0,8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MetroIcon}">
                                                    <Setter Property="Text" Value="&#xE9CE;"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Dashboard.Identification}" Value="Identified">
                                                            <Setter Property="Text" Value="&#xE73E;"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Foreground="White" FontSize="13" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Dashboard.IdentificationText}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Dashboard.Identification}" Value="Identified">
                                                            <Setter Property="Text" Value="Supported game"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Gameplay freshness strip -->
                            <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,20,0,0" Padding="14,9" CornerRadius="14"
                                    Background="#2E000000" BorderBrush="#33FFFFFF" BorderThickness="1">
                                <WrapPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                        <TextBlock Text="&#xE823;" FontSize="14" Style="{StaticResource MetroIcon}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Dashboard.FreshnessText}" Foreground="White" FontSize="13"/>
                                    </StackPanel>
                                    <TextBlock Foreground="#F0CBD0" FontSize="13" Margin="0,0,18,0"
                                               Text="{Binding Dashboard.GameFrame, StringFormat='Frame {0:N0}', TargetNullValue=''}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Dashboard.IsStale}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="&#xE7BA;" FontSize="13" Style="{StaticResource MetroIcon}" Foreground="#FFD9A0" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Dashboard.StaleHint}" Foreground="#FFE3BD" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <!-- M5.8.1: why there is no live data (same look as the stale hint). -->
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Dashboard.HasDiagnostic}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="&#xE7BA;" FontSize="13" Style="{StaticResource MetroIcon}" Foreground="#FFD9A0" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Dashboard.DiagnosticHint}" Foreground="#FFE3BD" FontSize="13" TextWrapping="Wrap" MaxWidth="560"/>
                                    </StackPanel>
                                    <!-- M5.8.2: the explicit, confirmed action beside the hint (disabled while an attempt runs). -->
                                    <Button Margin="0,8,0,0" HorizontalAlignment="Left"
                                            Command="{Binding Dashboard.EnableLiveTrackingCommand}"
                                            AutomationProperties.Name="Enable live tracking">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MetroGlossButton}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Dashboard.IsEnableLiveTrackingOffered}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="Enable live tracking"/>
                                    </Button>
                                </WrapPanel>
                            </Border>
                        </Grid>

                    </Grid>

                    <!-- ================= Tiles ================= -->
                    <!-- ================= Section separator ================= -->
                    <Grid Grid.Row="2" Margin="10,10,10,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentControl Style="{StaticResource GlossyStar}" Width="22" Height="22" Tag="1.8" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Live game data" Margin="10,0,14,0" VerticalAlignment="Center"
                                   FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource MetroTextPrimary}"/>
                        <Rectangle Grid.Column="2" Height="3" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF001E" Offset="0"/>
                                    <GradientStop Color="#80B80012" Offset="0.7"/>
                                    <GradientStop Color="#00B80012" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False">
                            <Ellipse Width="10" Height="10" Fill="#FF001E" Margin="0,0,6,0"/>
                            <Ellipse Width="7" Height="7" Fill="White" Opacity="0.8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <Ellipse Width="10" Height="10" Stroke="#FF001E" StrokeThickness="2"/>
                        </StackPanel>
                    </Grid>

                    <UniformGrid x:Name="TileGrid" Grid.Row="3" Columns="3">

                        <HeaderedContentControl Style="{StaticResource MetroTile}" Header="Connection" Tag="&#xE703;">
                            <StackPanel>
                                <TextBlock Style="{StaticResource MetroTileValue}" Text="{Binding Dashboard.ConnectionText, NotifyOnTargetUpdated=True}"/>
                                <TextBlock Style="{StaticResource MetroTileCaption}" Text="{Binding Dashboard.MonitoringStatusText}"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource MetroTile}" Header="Game" Tag="&#xE7FC;"
                                                ToolTip="{Binding Dashboard.IdentificationDetail}">
                            <StackPanel>
                                <TextBlock Text="{Binding Dashboard.IdentificationText, NotifyOnTargetUpdated=True}" FontSize="18" TextWrapping="Wrap" MaxHeight="52">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MetroTileValue}">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource MetroTileCaption}"
                                           Text="{Binding Dashboard.GameId, StringFormat='Catalog id: {0}', TargetNullValue='No catalog match'}"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource MetroTile}" Header="Session" Tag="&#xE916;">
                            <StackPanel>
                                <TextBlock Style="{StaticResource MetroTileValue}"
                                           Text="{Binding Dashboard.SessionDurationText, TargetNullValue={StaticResource Dash}}"/>
                                <TextBlock Style="{StaticResource MetroTileCaption}"
                                           Text="{Binding Dashboard.ProcessStartedUtc, Converter={StaticResource UtcToLocal}, StringFormat='Game started {0:t}', TargetNullValue='No game process'}"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource MetroGameplayTile}" Header="Location" Tag="&#xE707;">
                            <StackPanel>
                                <TextBlock Style="{StaticResource MetroTileValue}"
                                           Text="{Binding Dashboard.Map, NotifyOnTargetUpdated=True, TargetNullValue={StaticResource Dash}}"/>
                                <WrapPanel Margin="0,4,0,0">
                                    <TextBlock Style="{StaticResource MetroTileCaption}" Margin="0,0,10,0"
                                               Text="{Binding Dashboard.Age, StringFormat='Age: {0}', TargetNullValue='Age: —'}"/>
                                    <Border CornerRadius="8" Padding="7,1" Margin="0,0,6,0" Background="#40E02536" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Dashboard.EventPlaying}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="Cutscene" FontSize="12" Foreground="White"/>
                                    </Border>
                                    <Border CornerRadius="8" Padding="7,1" Background="#40E02536" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Dashboard.Loading}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="Loading" FontSize="12" Foreground="White"/>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource MetroGameplayTile}" Header="Hearts" Tag="&#xEB52;">
                            <StackPanel>
                                <TextBlock Style="{StaticResource MetroTileValue}" Text="{Binding Dashboard.HeartsText, NotifyOnTargetUpdated=True}"/>
                                <TextBlock Style="{StaticResource MetroTileCaption}" Text="Current / maximum"/>
                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Style="{StaticResource MetroGameplayTile}" Header="Rupees" Tag="&#xE8C7;">
                            <StackPanel>
                                <TextBlock Style="{StaticResource MetroTileValue}"
                                           Text="{Binding Dashboard.Rupees, StringFormat='{}{0:N0}', NotifyOnTargetUpdated=True, TargetNullValue={StaticResource Dash}}"/>
                                <TextBlock Style="{StaticResource MetroTileCaption}" Text="Wallet"/>
                            </StackPanel>
                        </HeaderedContentControl>
                    </UniformGrid>
                </Grid>
            </ScrollViewer>

            <!-- ================= Footer ================= -->
            <Grid Grid.Row="1" Margin="36,6,36,14">
                <TextBlock Text="Runs in the system tray — close to minimize" Foreground="{StaticResource MetroTextMuted}" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" Foreground="{StaticResource MetroTextMuted}" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
