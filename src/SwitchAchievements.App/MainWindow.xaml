<Window x:Class="SwitchAchievements.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Switch Achievements"
        Height="480" Width="720"
        MinHeight="400" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="{Binding ApplicationName}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="Windows achievement tracking" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Content="Settings" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="12,6"
                    Command="{Binding OpenSettingsCommand}" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"/>
        </Grid>

        <!-- Status cards -->
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Application status" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding ApplicationStatus}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Integration" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding IntegrationName}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                        <TextBlock Text="{Binding IntegrationStatus}" Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Monitoring" Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding MonitoringStatusText}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="2">
            <TextBlock Text="Runs in the system tray — close to minimize" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Version}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
