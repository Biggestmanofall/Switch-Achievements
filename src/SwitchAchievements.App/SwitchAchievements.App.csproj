<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SwitchAchievements.Core\SwitchAchievements.Core.csproj" />
    <ProjectReference Include="..\SwitchAchievements.Longshot\SwitchAchievements.Longshot.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Developer-owned supported-game catalog (M5.6.3), embedded so it travels with the
         application and is not user-editable. Resource names are exactly the forward-slash
         paths under the repository's catalog/ folder, e.g. "catalog/catalog.json":
         %(RecursiveDir) uses backslashes on Windows, so they are replaced at build time. -->
    <EmbeddedResource Include="..\..\catalog\**\*.json"
                      LogicalName="catalog/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
