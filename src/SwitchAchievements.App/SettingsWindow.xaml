<Window x:Class="SwitchAchievements.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI">
    <StackPanel Margin="20">
        <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" Foreground="{StaticResource PrimaryTextBrush}"/>
        <CheckBox Content="Start Switch Achievements when I sign in to Windows" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,12"/>
        <CheckBox Content="Show window on application launch" IsChecked="{Binding ShowWindowOnLaunch}" Margin="0,0,0,12"/>
        <CheckBox Content="Minimize to system tray when the main window is closed" IsChecked="{Binding MinimizeToTrayOnClose}" Margin="0,0,0,20"/>
        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#C62828" Margin="0,0,0,16">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Command="{Binding CancelCommand}"/>
            <Button Content="Save" Width="90" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
