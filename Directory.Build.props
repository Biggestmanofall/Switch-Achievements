<Project>

  <!--
    Shared build settings applied to every project in this folder tree.
    Keeping these in one place avoids repeating (and drifting) the same flags
    in each .csproj.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>